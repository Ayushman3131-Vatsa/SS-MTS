# Postgres connection used by the shared-schema tenant DB.
# This is the single seam app/db/session.py reads from; if the isolation
# model ever moves to schema-per-tenant, this is what becomes per-tenant.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/multi_tenant_poc

# Alembic must use a privileged table-owner role in production while
# DATABASE_URL uses a non-owner, non-BYPASSRLS application role. Development
# may omit this and Alembic will fall back to DATABASE_URL.
MIGRATION_DATABASE_URL=

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Opaque browser sessions
BROWSER_SESSION_EXPIRE_MINUTES=60
SESSION_COOKIE_NAME=mt_session
CSRF_COOKIE_NAME=mt_csrf

# Shared, database-backed login throttling
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_ACCOUNT_FAILURE_LIMIT=5
AUTH_IP_FAILURE_LIMIT=20
AUTH_LOCKOUT_MINUTES=15

# Transport hardening
MAX_REQUEST_BODY_BYTES=1048576

# Permanently delete deactivated or expired offering entitlements after this
# retention period. Run scripts.reconcile_offering_entitlements on a schedule.
DEACTIVATED_OFFERING_RETENTION_DAYS=90

# Task Management attachment storage (local adapter for this release).
# Keep this outside the application/static-file directory. If omitted, the
# application uses an OS temporary-data directory in development.
# ATTACHMENT_STORAGE_ROOT=/var/lib/multi-tenant-poc/attachments
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_PER_TASK=20
ATTACHMENT_ALLOWED_MEDIA_TYPES=image/png,image/jpeg,image/webp,application/pdf,text/plain,text/csv,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# Uvicorn consumes this directly when proxy headers are enabled. In production,
# set only the IP/CIDR of your trusted reverse proxy; never use "*" on a
# publicly reachable application server.
FORWARDED_ALLOW_IPS=127.0.0.1

ENVIRONMENT=development

# Exact browser origins permitted when the frontend calls this API directly.
# Prefer a same-origin /api proxy and leave this empty when possible. Never use
# "*" because browser requests include session cookies.
CORS_ALLOWED_ORIGINS=

# Smartskale setup user created for every registered tenant.
# Username is ss_<TENANT_CODE>_admin. Password must meet the account policy
# (upper, lower, digit, special). Name is always "Smartskale Admin".
SMARTSKALE_SETUP_EMAIL=hrms.support@smartskale.com
SMARTSKALE_SETUP_PASSWORD=Smartskale123!

