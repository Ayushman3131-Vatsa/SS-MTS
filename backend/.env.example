# Postgres connection used by the shared-schema tenant DB.
# This is the single seam app/db/session.py reads from; if the isolation
# model ever moves to schema-per-tenant, this is what becomes per-tenant.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/multi_tenant_poc

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Opaque browser sessions
BROWSER_SESSION_EXPIRE_MINUTES=60
SESSION_COOKIE_NAME=mt_session
CSRF_COOKIE_NAME=mt_csrf

# Shared, database-backed login throttling
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_ACCOUNT_FAILURE_LIMIT=5
AUTH_IP_FAILURE_LIMIT=20
AUTH_LOCKOUT_MINUTES=15

# Transport hardening
MAX_REQUEST_BODY_BYTES=1048576

# Permanently delete deactivated or expired offering entitlements after this
# retention period. Run scripts.reconcile_offering_entitlements on a schedule.
DEACTIVATED_OFFERING_RETENTION_DAYS=90

# Uvicorn consumes this directly when proxy headers are enabled. In production,
# set only the IP/CIDR of your trusted reverse proxy; never use "*" on a
# publicly reachable application server.
FORWARDED_ALLOW_IPS=127.0.0.1

ENVIRONMENT=development
