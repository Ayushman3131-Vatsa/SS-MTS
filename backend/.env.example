# Postgres connection used by the shared-schema tenant DB.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/multi_tenant_poc

# JWT Authentication
JWT_SECRET_KEY=change-me-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Opaque browser sessions & CSRF protection
BROWSER_SESSION_EXPIRE_MINUTES=60
SESSION_COOKIE_NAME=mt_session
CSRF_COOKIE_NAME=mt_csrf

# Shared, database-backed login throttling
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_ACCOUNT_FAILURE_LIMIT=5
AUTH_IP_FAILURE_LIMIT=20
AUTH_LOCKOUT_MINUTES=15

# Transport hardening
MAX_REQUEST_BODY_BYTES=1048576

# Trusted reverse proxy IPs
FORWARDED_ALLOW_IPS=127.0.0.1

# Environment (development | production)
ENVIRONMENT=development

# Exact browser origins permitted when the frontend calls this API directly.
# Prefer a same-origin /api proxy and leave this empty when possible. Never use
# "*" because browser requests include session cookies.
CORS_ALLOWED_ORIGINS=

# System Setup Credentials

# Smartskale setup user created for every registered tenant uses a unique,
# generated temporary password and must change it at first sign-in.
SMARTSKALE_SETUP_EMAIL=hrms.support@smartskale.com

# Google SMTP Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hrms.smartskale@gmail.com
# 16-character Google App Password (from myaccount.google.com/apppasswords)
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=hrms.smartskale@gmail.com
SMTP_FROM_NAME=SmartSkale HRMS
SMTP_USE_TLS=true
