# Postgres connection used by the shared-schema tenant DB.
# This is the single seam app/db/session.py reads from; if the isolation
# model ever moves to schema-per-tenant, this is what becomes per-tenant.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/multi_tenant_poc

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

ENVIRONMENT=development
